{
  "name": "@devslab/locale-match-vue",
  "version": "0.1.2",
  "description": "Vue 3 binding for @devslab/locale-match — a useLocale() composable with SSR-safe hydration.",
  "license": "Apache-2.0",
  "author": "devslab",
  "homepage": "https://devslab-kr.github.io/locale-match/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devslab-kr/locale-match.git",
    "directory": "packages/locale-match-vue"
  },
  "bugs": "https://github.com/devslab-kr/locale-match/issues",
  "keywords": ["vue", "vue3", "i18n", "locale", "accept-language", "composable", "ssr"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": { "vue": "^3.3.0" },
  "dependencies": { "@devslab/locale-match": "workspace:^" },
  "devDependencies": { "vue": "^3.5.12" }
}
